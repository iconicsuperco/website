# Browser-safe commerce endpoint. Never place secret keys in a VITE_* variable.
VITE_COMMERCE_API_URL=http://localhost:8787/api

# Server
PORT=8787
STORE_ORIGIN=http://localhost:5173
# Set only when the first trusted reverse proxy supplies the client IP.
TRUST_PROXY=false

# Admin control panel
ADMIN_PASSWORD=replace_with_a_long_private_password
ADMIN_SESSION_SECRET=replace_with_a_separate_random_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_the_dedicated_webhook_secret
# Keep the old secret during webhook-secret rotation so queued retries verify.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Shiprocket API user and exact pickup-location name
SHIPROCKET_EMAIL=replace_me
SHIPROCKET_PASSWORD=replace_me
SHIPROCKET_PICKUP_LOCATION=Primary

# COD remains off unless this is explicitly true and every courier field below
# is present. Enable it only after serviceability and order-verification review.
ENABLE_COD=false

# Temporary parcel defaults. Replace with SKU-level data from the Amazon CSV.
SHIPROCKET_DEFAULT_WEIGHT_KG=
SHIPROCKET_DEFAULT_LENGTH_CM=
SHIPROCKET_DEFAULT_BREADTH_CM=
SHIPROCKET_DEFAULT_HEIGHT_CM=
